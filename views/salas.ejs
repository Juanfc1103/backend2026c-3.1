<!DOCTYPE html>
<html>
  <head>
    <title><%= title %></title>
    <link rel="stylesheet" href="/stylesheets/style.css" />
  </head>
  <body>
    <h1><%= title %></h1>
    <table border="1">
      <thead>
        <tr>
          <th>ID</th>
          <th>Nombre</th>
          <th>Capacidad</th>
          <th>Acciones</th>
        </tr>
      </thead>
      <tbody>
        <% salas.forEach(s => { %>
          <tr>
            <td><%= s.id %></td>
            <td><%= s.nombre %></td>
            <td><%= s.capacidad %></td>
            <td>
              <button onclick="editar('<%= s.id %>')">Editar</button>
              <button onclick="eliminar('<%= s.id %>')">Eliminar</button>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
    <h2>Registrar nueva sala</h2>
    <form action="/salas/create" method="POST">
      <input type="text" name="nombre" placeholder="Nombre" required />
      <input type="number" name="capacidad" placeholder="Capacidad" required />
      <button type="submit">Registrar</button>
    </form>
    <a href="/">Volver</a>
    <script>
      async function eliminar(id) {
        if (!confirm("Eliminar sala?")) return;
        await fetch("/salas/delete/" + id, { method: "DELETE" });
        location.reload();
      }
      async function editar(id) {
        const nombre = prompt("Nuevo nombre");
        const capacidad = prompt("Nueva capacidad");
        await fetch("/salas/update/" + id, {
          method: "PUT",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ nombre, capacidad })
        });
        location.reload();
      }
    </script>
  </body>
</html>

